# LiveKit Server 認証情報
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretkeyforlocalvoiceai2026

# 内部通信 URL (Docker ネットワーク内)
LIVEKIT_URL=ws://livekit-server:7880
VLLM_BASE_URL=http://vllm:8000/v1
AUDIO_BASE_URL=http://audio-service:8000/v1

# ブラウザからアクセスする LiveKit の公開URL
# リモートマシンで動かす場合は、localhost をマシンの IP アドレスに変更してください (例: ws://192.168.1.100:7880)
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# モデル構成
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
WHISPER_MODEL=Systran/faster-whisper-medium
KOKORO_VOICE=jf_alpha

# 並行処理設定 (10人同時接続向け)
NUM_IDLE_PROCESSES=4
